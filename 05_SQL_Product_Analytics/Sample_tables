20. DAU/MAU Stickiness
WITH daily AS
(
SELECT

COUNT(DISTINCT user_id) dau

FROM orders

WHERE order_date='2026-06-15'
),

monthly AS
(
SELECT

COUNT(DISTINCT user_id) mau

FROM orders

WHERE DATE_TRUNC('month',order_date)='2026-06-01'
)

SELECT

dau,

mau,

ROUND(dau*100.0/mau,2) AS stickiness

FROM daily,monthly;