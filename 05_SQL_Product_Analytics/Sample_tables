17. Average Delivery Time
SELECT

AVG(delivery_time)

FROM orders

WHERE order_status='Delivered';


18. Top Cities by Revenue
SELECT

u.city,

SUM(o.order_value) revenue

FROM orders o

JOIN users u

ON o.user_id=u.user_id

GROUP BY u.city

ORDER BY revenue DESC;


